{
  "name": "float-translator",
  "version": "1.0.0",
  "description": "Always-on-top LLM based translator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-packager . FloatTranslator --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icons/icon.ico"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "electron-icon-builder": "^2.0.1",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "marked": "^18.0.3"
  },
  "build": {
    "appId": "com.float.translator",
    "productName": "FloatTranslator",
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
